<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- Definição de tipos de pedestres -->
    <vType id="Pedestrian1" vClass="pedestrian" 
           accel="0.1" decel="0.1" 
           length="0.5" width="0.4" 
           maxSpeed="0.2" speedDev="0.2" sigma="0.5" 
           minGap="0.2" />
	
	<vType id="Pedestrian2" vClass="pedestrian" 
           accel="0.1" decel="0.1" 
           length="0.5" width="0.4" 
           maxSpeed="0.24" speedDev="0.2" sigma="0.5" 
           minGap="0.2" />

    <!-- Rota do Pedestre 1: edge_p1_1 -> edge_p1_2 -> edge_p1_3 -->
    <person id="ped1" depart="0" type="Pedestrian1">
        <walk edges="edge_p1_1 edge_p1_2 edge_p1_3 edge_p1_4" />
    </person>

    <!-- Rota do Pedestre 2: edge_p1_1 -> edge_p2_2 -> edge_p2_3 -->
    <person id="ped2" depart="0" type="Pedestrian2">
        <walk edges="edge_p2_1 edge_p2_2 edge_p2_3 edge_p2_4" />
    </person>

</routes>
